<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Media permissions — correct for all supported API levels -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Foreground service — required for Media3 playback notification -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Post notifications (Android 13+) for the media notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Wake lock — Media3 handles this internally when playing -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".SwaraApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Swara">

        <!-- V2 Single Activity — Navigation Component handles all screen transitions -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SwaraLauncher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            SwaraPlaybackService — Media3 MediaSessionService
            - foregroundServiceType = mediaPlayback is REQUIRED on Android 14+ for media playback
            - exported = true is required for MediaSession to be reachable from the notification
            - Does NOT override onTaskRemoved — background playback continues after task removal
        -->
        <service
            android:name=".service.SwaraPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!--
            SwaraWidgetProvider — AppWidgetProvider that makes the Now Playing widget
            appear in the system widget picker.

            The two required entries:
              1. APPWIDGET_UPDATE action intent-filter — tells Android
                 this receiver is an AppWidget provider.
              2. android.appwidget.provider meta-data pointing to the XML descriptor —
                 this is what the widget picker reads for size, description, preview, etc.
        -->
        <receiver
            android:name=".widget.SwaraWidgetProvider"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_swara_player_info" />
        </receiver>

        <!--
            SwaraWidgetReceiver — handles play/pause/next/prev button taps and
            widget-update broadcasts from SwaraPlaybackService.
            exported=false: only our own app sends these broadcasts.
        -->
        <receiver
            android:name=".widget.SwaraWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.psthetech.swara.ACTION_PLAY_PAUSE" />
                <action android:name="com.psthetech.swara.ACTION_NEXT" />
                <action android:name="com.psthetech.swara.ACTION_PREV" />
                <action android:name="com.psthetech.swara.ACTION_WIDGET_UPDATE" />
            </intent-filter>
        </receiver>

    </application>

</manifest>