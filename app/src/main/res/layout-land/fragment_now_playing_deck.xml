<?xml version="1.0" encoding="utf-8"?>
<!-- Deck skin, landscape: reel on the left, panel on the right. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nowPlayingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Kept inside the root, as in the other Now Playing layouts: the fragment pads npContent
         for the cutout while the root draws the body edge to edge. -->
    <LinearLayout
        tools:ignore="UselessParent"
        android:id="@+id/npContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingHorizontal="28dp"
        android:paddingVertical="8dp"
        android:baselineAligned="false">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginVertical="16dp">

            <com.psthetech.swara.ui.deck.DeckReelView
                android:id="@+id/deckReel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cd_deck_reel"
                android:focusable="true" />

            <com.psthetech.swara.ui.deck.DeckKeyView
                android:id="@+id/btnStandby"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="bottom|end"
                android:src="@drawable/ic_standby"
                android:contentDescription="@string/deck_standby" />
        </FrameLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/npScroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:layout_marginStart="16dp"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <View
                    android:id="@+id/dragHandle"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <include
                    layout="@layout/view_np_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp" />

                <include
                    layout="@layout/view_np_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    layout="@layout/view_deck_seek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/np_gap_tight" />

                <include
                    layout="@layout/view_deck_transport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/np_gap_tight" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="@dimen/np_gap_tight" />

                <include
                    layout="@layout/view_deck_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</FrameLayout>
