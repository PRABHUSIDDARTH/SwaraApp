<?xml version="1.0" encoding="utf-8"?>
<!-- Now Playing (landscape, compact): large artwork on the left; everything else on the right.
     The right column is a ScrollView only as a safety net: at normal font sizes the spacers
     absorb the slack and nothing scrolls; at large font scale it scrolls instead of clipping. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nowPlayingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/ivBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        android:contentDescription="@null" />

    <View
        android:id="@+id/viewBackdropScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="8dp">

            <com.psthetech.swara.ui.widget.CircularArtworkView
                android:id="@+id/circularArtworkView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_album_art"
                android:focusable="true"
                android:clickable="true" />
        </FrameLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/npScroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.15"
            android:layout_marginStart="12dp"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="4dp">

                <View
                    android:id="@+id/dragHandle"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <include
                    layout="@layout/view_np_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="1" android:minHeight="@dimen/np_gap_tight" />

                <include
                    layout="@layout/view_np_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    layout="@layout/view_np_seek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/np_gap_tight" />

                <include
                    layout="@layout/view_np_transport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/np_gap_tight" />

                <View android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="1" android:minHeight="@dimen/np_gap_tight" />

                <include
                    layout="@layout/view_np_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</FrameLayout>
