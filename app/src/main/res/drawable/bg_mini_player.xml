<?xml version="1.0" encoding="utf-8"?>
<!-- Mini-player glass surface: fully-rounded pill shape (static fallback).
     The real glass treatment (highlight gradient + translucent fill + stroke)
     is applied dynamically in MiniPlayerFragment via DesignTokens.createGlassMiniPlayerDrawable().
     This XML is a clean rounded-rect fallback used only if the fragment hasn't applied tokens yet. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/swara_surface_1" />
    <corners android:radius="@dimen/radius_lg" />
</shape>
