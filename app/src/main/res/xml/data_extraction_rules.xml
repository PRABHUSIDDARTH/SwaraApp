<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup / device-transfer rules for Android 12+. See backup_rules.xml for why only
    preferences are included: everything else is keyed by device-specific MediaStore IDs.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="swara_playback_state.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="swara_playback_state.xml" />
    </device-transfer>
</data-extraction-rules>
