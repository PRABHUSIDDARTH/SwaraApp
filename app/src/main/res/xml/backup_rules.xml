<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup rules for Android 11 and lower (API 31+ uses data_extraction_rules.xml).

    Favorites, playlists, history and custom artwork are keyed by MediaStore song IDs, which
    are assigned per device. Restoring them elsewhere would point at the wrong songs, so only
    preferences (theme, sort order, settings) are backed up. The saved playback queue is
    excluded for the same reason.
-->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <exclude domain="sharedpref" path="swara_playback_state.xml" />
</full-backup-content>
