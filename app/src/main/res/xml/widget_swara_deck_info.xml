<?xml version="1.0" encoding="utf-8"?>
<!-- The Swara Deck widget. The sizes are copied from widget_swara_player_info, which One UI places
     at 4x2; sizes of our own made it offer more rows. It is not resizable, because the six keys
     and the reel need this much room. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:targetApi="31"
    android:minWidth="180dp"
    android:minHeight="160dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="50dp"
    android:maxResizeWidth="500dp"
    android:maxResizeHeight="400dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_swara_deck"
    android:previewImage="@mipmap/ic_launcher"
    android:resizeMode="none"
    android:widgetCategory="home_screen"
    android:description="@string/widget_deck_description" />
