<?xml version="1.0" encoding="utf-8"?>
<!-- Now Playing (portrait): artwork-tinted backdrop, large disc artwork, clear hierarchy
     (title > artist > album), flat scrubber, glyph-only transport, five equal action slots.
     Shared parts live in view_np_*.xml so portrait and landscape stay identical in behaviour. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nowPlayingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/ivBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        android:contentDescription="@null" />

    <View
        android:id="@+id/viewBackdropScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/npContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/page_pad_h"
            android:paddingTop="@dimen/dp_8"
            android:paddingBottom="@dimen/dp_24">

            <View
                android:id="@+id/dragHandle"
                android:layout_width="38dp"
                android:layout_height="5dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/dp_4"
                android:background="@drawable/shape_drag_handle" />

            <include
                layout="@layout/view_np_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4" />

            <com.psthetech.swara.ui.widget.CircularArtworkView
                android:id="@+id/circularArtworkView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:contentDescription="@string/cd_album_art"
                android:focusable="true"
                android:clickable="true" />

            <include
                layout="@layout/view_np_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/np_gap_group" />

            <include
                layout="@layout/view_np_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12" />

            <include
                layout="@layout/view_np_transport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16" />

            <include
                layout="@layout/view_np_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/np_gap_group" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
