<?xml version="1.0" encoding="utf-8"?>
<!-- Now Playing — full screen bottom sheet -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:paddingHorizontal="@dimen/dp_24"
    android:paddingTop="@dimen/dp_16"
    android:paddingBottom="@dimen/dp_24">

    <!-- Drag Handle Indicator -->
    <View
        android:id="@+id/dragHandle"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/shape_drag_handle" />

    <!-- Drag handle / top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="@dimen/dp_16">

        <!-- Back / collapse button -->
        <ImageView
            android:id="@+id/btnCollapse"
            android:layout_width="@dimen/btn_min_touch_target"
            android:layout_height="@dimen/btn_min_touch_target"
            android:src="@drawable/ic_arrow_back"
            android:scaleType="center"
            android:background="@drawable/ripple_circle"
            android:rotation="-90"
            android:contentDescription="@string/close" />

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <TextView
            android:id="@+id/nowPlayingHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/now_playing"
            android:textSize="@dimen/text_label_md"
            android:textColor="@color/swara_text_secondary"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12" />

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <!-- Queue button -->
        <ImageView
            android:id="@+id/btnQueue"
            android:layout_width="@dimen/btn_min_touch_target"
            android:layout_height="@dimen/btn_min_touch_target"
            android:src="@drawable/ic_queue_music"
            android:scaleType="center"
            android:background="@drawable/ripple_circle"
            android:contentDescription="@string/queue" />

    </LinearLayout>

    <!-- Large album artwork -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivArtwork"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Large"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintWidth_max="360dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:padding="6dp"
            android:scaleType="centerCrop"
            android:background="@color/swara_surface_3"
            android:src="@drawable/ic_artwork_fallback"
            android:elevation="@dimen/elevation_4"
            android:contentDescription="Album art" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Song info + favorite -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="@dimen/dp_24">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_headline_md"
                android:textColor="@color/swara_text_primary"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_body_md"
                android:textColor="@color/swara_text_secondary"
                android:layout_marginTop="@dimen/dp_4"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

        <!-- Favorite toggle -->
        <ImageView
            android:id="@+id/btnFavorite"
            android:layout_width="@dimen/btn_min_touch_target"
            android:layout_height="@dimen/btn_min_touch_target"
            android:src="@drawable/ic_favorite_border"
            android:scaleType="center"
            android:background="@drawable/ripple_circle"
            android:contentDescription="@string/cd_favorite_empty" />

    </LinearLayout>

    <!-- SeekBar -->
    <SeekBar
        android:id="@+id/seekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20" />

    <!-- Time labels -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/dp_4">

        <TextView
            android:id="@+id/tvCurrentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textSize="@dimen/text_label_md"
            android:textColor="@color/swara_text_dim" />

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <TextView
            android:id="@+id/tvTotalTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textSize="@dimen/text_label_md"
            android:textColor="@color/swara_text_dim" />

    </LinearLayout>

    <!-- Main controls row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="@dimen/dp_24">

        <!-- Shuffle -->
        <ImageView
            android:id="@+id/btnShuffle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_shuffle"
            android:scaleType="center"
            android:background="@drawable/ripple_circle"
            android:contentDescription="@string/shuffle" />

        <!-- Previous -->
        <ImageView
            android:id="@+id/btnPrevious"
            android:layout_width="@dimen/btn_secondary_size"
            android:layout_height="@dimen/btn_secondary_size"
            android:src="@drawable/ic_skip_prev"
            android:scaleType="center"
            android:background="@drawable/ripple_circle"
            android:contentDescription="@string/previous" />

        <!-- Entire glass control is the playback touch target. -->
            <ImageView
                android:id="@+id/btnPlayPause"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:padding="16dp"
                android:background="@drawable/bg_play_button"
                android:src="@drawable/ic_play"
                android:scaleType="center"
                android:contentDescription="@string/play_pause" />


        <!-- Next -->
        <ImageView
            android:id="@+id/btnNext"
            android:layout_width="@dimen/btn_secondary_size"
            android:layout_height="@dimen/btn_secondary_size"
            android:src="@drawable/ic_skip_next"
            android:scaleType="center"
            android:background="@drawable/ripple_circle"
            android:contentDescription="@string/next" />

        <!-- Repeat -->
        <ImageView
            android:id="@+id/btnRepeat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_repeat"
            android:scaleType="center"
            android:background="@drawable/ripple_circle"
            android:contentDescription="@string/repeat" />

    </LinearLayout>

    <!-- Secondary controls row: Sleep Timer + Equalizer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="@dimen/dp_16">

        <!-- Sleep Timer -->
        <ImageView
            android:id="@+id/btnSleepTimer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_timer"
            android:scaleType="center"
            android:background="@drawable/ripple_circle"
            android:contentDescription="@string/sleep_timer" />

        <!-- Equalizer -->
        <ImageView
            android:id="@+id/btnEqualizer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_equalizer"
            android:scaleType="center"
            android:background="@drawable/ripple_circle"
            android:contentDescription="@string/equalizer" />

    </LinearLayout>

</LinearLayout>
</androidx.core.widget.NestedScrollView>

