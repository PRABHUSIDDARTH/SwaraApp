<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/editSongScrollRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/editSongContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- Drag handle pill -->
        <View
            android:id="@+id/dragPill"
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_rounded_gold_alpha" />

        <!-- Header Row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvEditorHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/edit_song_info"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true" />

            <ImageView
                android:id="@+id/btnCloseEditor"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/ripple_circle"
                android:contentDescription="@string/cancel"
                android:padding="8dp"
                android:src="@drawable/ic_close" />

        </RelativeLayout>

        <!-- Song Artwork & Meta Preview Card -->
        <LinearLayout
            android:id="@+id/cardPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivEditorArtwork"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Swara.RoundedCorner.12dp"
                android:src="@drawable/ic_artwork_fallback" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPreviewTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPreviewSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvFormatBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:textAllCaps="true" />

            </LinearLayout>

        </LinearLayout>

        <!-- TITLE FIELD -->
        <TextView
            android:id="@+id/lblTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/field_title"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:id="@+id/containerTitle"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="12dp">

            <EditText
                android:id="@+id/etTitle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="@string/field_title"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- ARTIST FIELD -->
        <TextView
            android:id="@+id/lblArtist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/field_artist"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:id="@+id/containerArtist"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="12dp">

            <EditText
                android:id="@+id/etArtist"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="@string/field_artist"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- ALBUM FIELD -->
        <TextView
            android:id="@+id/lblAlbum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/field_album"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:id="@+id/containerAlbum"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="12dp">

            <EditText
                android:id="@+id/etAlbum"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="@string/field_album"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- ALBUM ARTIST FIELD -->
        <TextView
            android:id="@+id/lblAlbumArtist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/field_album_artist"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:id="@+id/containerAlbumArtist"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="12dp">

            <EditText
                android:id="@+id/etAlbumArtist"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="@string/field_album_artist"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- GENRE FIELD -->
        <TextView
            android:id="@+id/lblGenre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/field_genre"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:id="@+id/containerGenre"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="12dp">

            <EditText
                android:id="@+id/etGenre"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="@string/field_genre"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- ROW: YEAR, TRACK, DISC -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="12dp">

            <!-- Year -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lblYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/field_year"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:id="@+id/containerYear"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp">

                    <EditText
                        android:id="@+id/etYear"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="2024"
                        android:inputType="number"
                        android:maxLength="4"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Track Number -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lblTrack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/field_track"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:id="@+id/containerTrack"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp">

                    <EditText
                        android:id="@+id/etTrack"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="1"
                        android:inputType="number"
                        android:maxLength="3"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Disc Number -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lblDisc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/field_disc"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:id="@+id/containerDisc"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp">

                    <EditText
                        android:id="@+id/etDisc"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="1"
                        android:inputType="number"
                        android:maxLength="2"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- COMPOSER FIELD -->
        <TextView
            android:id="@+id/lblComposer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/field_composer"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:id="@+id/containerComposer"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="12dp">

            <EditText
                android:id="@+id/etComposer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="@string/field_composer"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- COMMENT FIELD -->
        <TextView
            android:id="@+id/lblComment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/field_comment"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:id="@+id/containerComment"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="top"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:layout_marginBottom="18dp">

            <EditText
                android:id="@+id/etComment"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="@string/field_comment"
                android:inputType="textMultiLine"
                android:maxLines="3"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Loading spinner (during save) -->
        <ProgressBar
            android:id="@+id/editorProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:indeterminate="true"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <!-- ACTION BUTTONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnCancelEdit"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/cancel"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/btnSaveEdit"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.4"
                android:gravity="center"
                android:text="@string/save"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
