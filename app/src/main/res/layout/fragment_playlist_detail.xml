<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Header row: back + overflow menu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/ripple_circle"
            android:contentDescription="@string/back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Overflow menu: Rename, Delete -->
        <ImageView
            android:id="@+id/btnPlaylistOverflow"
            android:layout_width="@dimen/btn_min_touch_target"
            android:layout_height="@dimen/btn_min_touch_target"
            android:background="@drawable/ripple_circle"
            android:contentDescription="@string/more_options"
            android:padding="12dp"
            android:src="@drawable/ic_more_vert" />

    </LinearLayout>

    <!-- Hero playlist artwork — visual anchor -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="12dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivPlaylistDetailArtwork"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center_horizontal"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_playlist"
            android:elevation="@dimen/elevation_2"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Large" />

        <!-- Camera badge for artwork editing -->
        <ImageView
            android:id="@+id/ivArtworkEditBadge"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center|bottom"
            android:layout_marginBottom="4dp"
            android:layout_marginStart="116dp"
            android:src="@drawable/ic_camera"
            android:background="@drawable/bg_rounded_gold_alpha"
            android:padding="8dp"
            android:elevation="@dimen/elevation_3"
            android:contentDescription="@string/change_artwork" />

    </FrameLayout>

    <!-- Playlist Info: Title and Song Count / Duration below artwork -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/playlistTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:gravity="center"
            android:textColor="@color/swara_text_primary"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/playlistMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@color/swara_text_muted"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Action bar: Play, Shuffle, Add Songs -->
    <LinearLayout
        android:id="@+id/layoutPlaylistActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingBottom="14dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnPlayAll"
            style="@style/Widget.Swara.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/play"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnShuffle"
            style="@style/Widget.Swara.Button.Ghost"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/shuffle"
            android:layout_marginEnd="10dp" />

        <ImageView
            android:id="@+id/btnAddSongs"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/ripple_circle"
            android:contentDescription="@string/add_songs"
            android:padding="10dp"
            android:src="@drawable/ic_add" />

    </LinearLayout>

    <!-- Song list (empty state + RecyclerView) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="@dimen/bottom_content_padding" />

        <LinearLayout
            android:id="@+id/layoutEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/dp_32"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:alpha="0.3"
                android:src="@drawable/ic_queue_music" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/playlist_empty_title"
                android:textColor="@color/swara_text_primary"
                android:textSize="@dimen/text_title_md" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:gravity="center"
                android:text="@string/playlist_empty_subtitle"
                android:textColor="@color/swara_text_secondary"
                android:textSize="@dimen/text_body_sm" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
