<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/voiceSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="28dp">

    <!-- Drag Handle Pill -->
    <View
        android:id="@+id/dragPill"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_rounded_gold_alpha" />

    <!-- Glass card -->
    <LinearLayout
        android:id="@+id/cardVoice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp">

        <ImageView
            android:id="@+id/ivVoiceMic"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:padding="18dp"
            android:src="@drawable/ic_mic"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tvVoiceTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/voice_listening"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:gravity="center"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/swara_text_primary" />

        <!-- Level bar -->
        <FrameLayout
            android:id="@+id/levelTrack"
            android:layout_width="160dp"
            android:layout_height="6dp"
            android:layout_marginTop="14dp">

            <View
                android:id="@+id/levelFill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleX="0" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvVoiceReply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textSize="16sp"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/swara_text_secondary"
            android:visibility="gone" />

        <!-- Choice chips (MEDIUM: "Yes" + alternatives; AMBIGUOUS: all) -->
        <LinearLayout
            android:id="@+id/chipContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnVoiceAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="44dp"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <!-- Debug builds: typed-command readout -->
        <TextView
            android:id="@+id/tvVoiceDebug"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="10dp"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textIsSelectable="true"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
