<?xml version="1.0" encoding="utf-8"?>
<!-- Top bar: collapse, card | Now playing | share, queue (balanced so the label stays centred). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/btnCollapse"
        android:layout_width="@dimen/btn_min_touch_target"
        android:layout_height="@dimen/btn_min_touch_target"
        android:layout_marginStart="-12dp"
        android:src="@drawable/ic_arrow_back"
        android:scaleType="center"
        android:background="@drawable/ripple_circle"
        android:rotation="-90"
        android:contentDescription="@string/close" />

    <ImageView
        android:id="@+id/btnShareCard"
        android:layout_width="@dimen/btn_min_touch_target"
        android:layout_height="@dimen/btn_min_touch_target"
        android:src="@drawable/ic_share_card"
        android:scaleType="center"
        android:background="@drawable/ripple_circle"
        android:contentDescription="@string/share_card"
        android:tooltipText="@string/share_card" />

    <TextView
        android:id="@+id/nowPlayingHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/now_playing"
        android:textSize="12sp"
        android:textAllCaps="true"
        android:letterSpacing="0.12"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/swara_text_secondary" />

    <ImageView
        android:id="@+id/btnShare"
        android:layout_width="@dimen/btn_min_touch_target"
        android:layout_height="@dimen/btn_min_touch_target"
        android:src="@drawable/ic_share"
        android:scaleType="center"
        android:background="@drawable/ripple_circle"
        android:contentDescription="@string/share_nearby"
        android:tooltipText="@string/share_nearby" />

    <ImageView
        android:id="@+id/btnQueue"
        android:layout_width="@dimen/btn_min_touch_target"
        android:layout_height="@dimen/btn_min_touch_target"
        android:layout_marginEnd="-12dp"
        android:src="@drawable/ic_queue_music"
        android:scaleType="center"
        android:background="@drawable/ripple_circle"
        android:contentDescription="@string/queue" />

</LinearLayout>
