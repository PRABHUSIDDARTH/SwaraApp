<?xml version="1.0" encoding="utf-8"?>
<!-- Songs list with header bar (sort) and loading/empty states -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- Header bar: label + shuffle + sort button -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/songs"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Shuffle all — plays all songs in random order -->
        <ImageView
            android:id="@+id/btnShuffle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@drawable/ic_shuffle"
            android:background="@drawable/ripple_circle"
            android:contentDescription="@string/shuffle"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="4dp"
            app:tint="?attr/colorSecondary" />

        <!-- View mode toggle: compact list vs expanded cards -->
        <ImageView
            android:id="@+id/btnViewMode"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@drawable/ic_view_expanded"
            android:background="@drawable/ripple_circle"
            android:contentDescription="@string/view_mode"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="4dp"
            app:tint="?attr/colorSecondary" />

        <ImageView
            android:id="@+id/btnSort"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@drawable/ic_sort"
            android:background="@drawable/ripple_circle"
            android:contentDescription="@string/sort"
            app:tint="?attr/colorSecondary" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="@dimen/bottom_content_padding"
            android:clipToPadding="false"
            android:overScrollMode="never" />

    <!-- Loading state -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/swara_gold"
        android:visibility="gone" />

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/layoutEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/dp_32"
        android:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_artwork_fallback"
            android:alpha="0.35" />

        <TextView
            android:id="@+id/tvEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/library_empty_title"
            android:textSize="@dimen/text_title_md"
            android:textColor="@color/swara_text_primary"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="@dimen/dp_16"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvEmptySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/library_empty_subtitle"
            android:textSize="@dimen/text_body_sm"
            android:textColor="@color/swara_text_secondary"
            android:layout_marginTop="@dimen/dp_8"
            android:gravity="center" />

    </LinearLayout>

    </FrameLayout>

</LinearLayout>
