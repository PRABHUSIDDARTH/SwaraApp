<?xml version="1.0" encoding="utf-8"?>
<!--
    Swara Now Playing widget, compact square (about 2x2).
    Artwork tile + live level glyph, title/artist, seekbar, transport.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    tools:ignore="UseAppTint,ContentDescription">

    <ImageView
        android:id="@+id/widget_bg_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_shape_fill"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/widget_bg_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_shape_glow"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/widget_bg_stroke"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_shape_stroke"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_album_art"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:maxHeight="64dp"
                android:maxWidth="64dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_artwork_fallback"
                android:contentDescription="@string/cd_widget_artwork" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_wave_progress"
                android:layout_width="13dp"
                android:layout_height="10dp"
                android:layout_marginTop="3dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/cd_playback_progress" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <TextView
                    android:id="@+id/widget_song_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:text="@string/widget_no_song"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.015"
                    android:maxLines="1"
                    android:ellipsize="end" />

            <TextView
                    android:id="@+id/widget_artist_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/widget_tap_to_play"
                    android:textColor="#99EBEBF5"
                    android:textSize="12sp"
                    android:letterSpacing="-0.01"
                    android:maxLines="1"
                    android:ellipsize="end" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/widget_seek_container"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="4dp">

            <ImageView
                android:id="@+id/widget_seek_progress"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="center_vertical"
                android:scaleType="fitXY"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">
                <FrameLayout
                    android:id="@+id/widget_seek_zone_0"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
                <FrameLayout
                    android:id="@+id/widget_seek_zone_1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
                <FrameLayout
                    android:id="@+id/widget_seek_zone_2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
                <FrameLayout
                    android:id="@+id/widget_seek_zone_3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
                <FrameLayout
                    android:id="@+id/widget_seek_zone_4"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
                <FrameLayout
                    android:id="@+id/widget_seek_zone_5"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
                <FrameLayout
                    android:id="@+id/widget_seek_zone_6"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
                <FrameLayout
                    android:id="@+id/widget_seek_zone_7"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
                <FrameLayout
                    android:id="@+id/widget_seek_zone_8"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
                <FrameLayout
                    android:id="@+id/widget_seek_zone_9"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/widget_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/widget_btn_prev"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_skip_prev"
                android:tint="#FFFFFF"
                android:contentDescription="@string/cd_widget_previous" />

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp">

                <ImageView
                    android:id="@+id/widget_play_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_play_circle"
                    android:importantForAccessibility="no" />

                <ImageButton
                    android:id="@+id/widget_btn_play_pause"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_play"
                    android:tint="#1A1A1A"
                    android:contentDescription="@string/cd_widget_play_pause" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/widget_btn_next"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_skip_next"
                android:tint="#FFFFFF"
                android:contentDescription="@string/cd_widget_next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
