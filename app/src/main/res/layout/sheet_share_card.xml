<?xml version="1.0" encoding="utf-8"?>
<!-- Share card sheet: live 9:16 preview, then a row of destinations. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shareCardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/dp_8"
    android:paddingBottom="@dimen/dp_24">

    <View
        android:layout_width="38dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/shape_drag_handle" />

    <TextView
        android:id="@+id/tvShareCardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:gravity="center"
        android:text="@string/share_card_title"
        android:textSize="17sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="-0.01" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:layout_marginTop="@dimen/dp_16">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivCardPreview"
            android:layout_width="214dp"
            android:layout_height="380dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:elevation="12dp"
            android:contentDescription="@string/share_card" />

        <ProgressBar
            android:id="@+id/progressCard"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center" />
    </FrameLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_24"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/layoutTargets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dp_16" />
    </HorizontalScrollView>

</LinearLayout>
