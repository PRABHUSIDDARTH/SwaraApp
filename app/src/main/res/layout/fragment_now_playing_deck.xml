<?xml version="1.0" encoding="utf-8"?>
<!-- Deck skin, portrait. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nowPlayingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/npContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="26dp"
            android:paddingBottom="30dp">

            <View
                android:id="@+id/dragHandle"
                android:layout_width="38dp"
                android:layout_height="5dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/shape_drag_handle" />

            <include
                layout="@layout/view_np_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="@dimen/np_gap_tight">

                <com.psthetech.swara.ui.deck.DeckReelView
                    android:id="@+id/deckReel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="200dp"
                    android:contentDescription="@string/cd_deck_reel"
                    android:focusable="true" />

                <com.psthetech.swara.ui.deck.DeckKeyView
                    android:id="@+id/btnStandby"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="bottom|end"
                    android:src="@drawable/ic_standby"
                    android:contentDescription="@string/deck_standby" />
            </FrameLayout>

            <include
                layout="@layout/view_np_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8" />

            <include
                layout="@layout/view_deck_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12" />

            <include
                layout="@layout/view_deck_transport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12" />

            <include
                layout="@layout/view_deck_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
