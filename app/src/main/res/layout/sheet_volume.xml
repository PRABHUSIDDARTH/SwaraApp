<?xml version="1.0" encoding="utf-8"?>
<!-- Media volume sheet: STREAM_MUSIC slider (kept in sync with the hardware keys) plus a row
     that opens the audio-output picker, so switching device is still one tap away. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/containerVolumeSheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="28dp">

    <View
        android:id="@+id/volDragPill"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_rounded_gold_alpha" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvVolumeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="@string/volume"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/swara_text_primary" />

        <ImageView
            android:id="@+id/btnCloseVolumeSheet"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/ripple_circle"
            android:contentDescription="@string/close"
            android:padding="8dp"
            android:src="@drawable/ic_close" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivVolumeIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_speaker"
            android:contentDescription="@null" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderVolume"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/volume"
            android:valueFrom="0"
            android:valueTo="15"
            android:stepSize="1" />

        <TextView
            android:id="@+id/tvVolumePercent"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:fontFeatureSettings="tnum"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/swara_text_secondary" />
    </LinearLayout>

    <!-- Output device: opens the existing picker -->
    <LinearLayout
        android:id="@+id/rowOutputDevice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp"
        android:minHeight="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:background="@drawable/bg_korokae_pill"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/audio_output">

        <ImageView
            android:id="@+id/ivOutputDeviceIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_speaker"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOutputLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/audio_output"
                android:textSize="12sp"
                android:textColor="@color/swara_text_secondary" />

            <TextView
                android:id="@+id/tvOutputDeviceName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/swara_text_primary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvOutputChange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/volume_change_output"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/swara_gold" />
    </LinearLayout>
</LinearLayout>
