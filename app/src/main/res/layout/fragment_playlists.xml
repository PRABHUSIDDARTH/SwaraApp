<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="@dimen/dp_16" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/playlists" android:textSize="@dimen/text_headline_md"
            android:textColor="@color/swara_text_primary" android:fontFamily="sans-serif-medium"/>
        <ImageView android:id="@+id/btnNewPlaylist" android:layout_width="@dimen/btn_min_touch_target"
            android:layout_height="@dimen/btn_min_touch_target" android:src="@drawable/ic_add"
            android:scaleType="center" android:background="@drawable/ripple_circle"
            android:tint="@color/swara_text_secondary" android:contentDescription="@string/new_playlist"/>
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerView"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:paddingBottom="@dimen/bottom_content_padding" android:clipToPadding="false" android:overScrollMode="never"/>
        <LinearLayout android:id="@+id/layoutEmpty" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center"
            android:orientation="vertical" android:gravity="center" android:padding="@dimen/dp_32" android:visibility="gone">
            <ImageView android:layout_width="72dp" android:layout_height="72dp"
                android:src="@drawable/ic_queue_music" android:alpha="0.3" android:id="@+id/ivEmptyIcon"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/playlists_empty_title" android:textSize="@dimen/text_title_md"
                android:textColor="@color/swara_text_primary" android:fontFamily="sans-serif-medium"
                android:layout_marginTop="@dimen/dp_16" android:gravity="center"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/playlists_empty_subtitle" android:textSize="@dimen/text_body_sm"
                android:textColor="@color/swara_text_secondary" android:layout_marginTop="@dimen/dp_8" android:gravity="center"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
