<?xml version="1.0" encoding="utf-8"?>
<!-- Swara Deck widget, 4x2 like the other Swara widget. Coloured from DesignTokens by
     DeckWidgetRenderer; the reel is a bitmap of DeckReelView with two rotating overlays while
     playing. The reel row takes the height the keys leave, and the reel shrinks to fit it
     (the ImageView and the indeterminate-only ProgressBars both keep it round). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/deck_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="UseAppTint,ContentDescription,NestedWeights">

    <FrameLayout
        tools:ignore="UselessParent"
        android:id="@+id/deck_widget_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/deck_widget_body"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/widget_deck_body"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/deck_widget_outline"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/widget_deck_outline"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/deck_screw_tl"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="top|start"
            android:layout_margin="9dp"
            android:src="@drawable/widget_deck_screw"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/deck_screw_slot_tl"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="top|start"
            android:layout_margin="9dp"
            android:src="@drawable/widget_deck_screw_slot"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/deck_screw_tr"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="top|end"
            android:layout_margin="9dp"
            android:src="@drawable/widget_deck_screw"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/deck_screw_slot_tr"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="top|end"
            android:layout_margin="9dp"
            android:src="@drawable/widget_deck_screw_slot"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/deck_screw_bl"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="bottom|start"
            android:layout_margin="9dp"
            android:src="@drawable/widget_deck_screw"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/deck_screw_slot_bl"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="bottom|start"
            android:layout_margin="9dp"
            android:src="@drawable/widget_deck_screw_slot"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/deck_screw_br"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="9dp"
            android:src="@drawable/widget_deck_screw"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/deck_screw_slot_br"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="9dp"
            android:src="@drawable/widget_deck_screw_slot"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/deck_widget_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <FrameLayout
                    android:layout_width="132dp"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/deck_reel"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/cd_deck_reel" />

                    <ProgressBar
                        android:id="@+id/deck_spin_windows"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:indeterminate="true"
                        android:indeterminateDrawable="@drawable/widget_deck_spin_windows"
                        android:indeterminateDuration="10000"
                        android:interpolator="@android:anim/linear_interpolator"
                        android:indeterminateOnly="true"
                        android:importantForAccessibility="no"
                        android:visibility="gone" />

                    <ProgressBar
                        android:id="@+id/deck_spin_marker"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:indeterminate="true"
                        android:indeterminateDrawable="@drawable/widget_deck_spin_marker"
                        android:indeterminateDuration="10000"
                        android:interpolator="@android:anim/linear_interpolator"
                        android:indeterminateOnly="true"
                        android:importantForAccessibility="no"
                        android:visibility="gone" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/deck_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/deck_artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textSize="13sp" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp">

                        <ImageView
                            android:id="@+id/deck_window"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitXY"
                            android:src="@drawable/widget_deck_key"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="28dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="10dp">

                            <Chronometer
                                android:id="@+id/deck_elapsed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/deck_total"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:fontFamily="monospace"
                                android:maxLines="1"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </FrameLayout>

                    <ProgressBar
                        android:id="@+id/deck_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="6dp"
                        android:max="1000"
                        android:progressDrawable="@drawable/widget_deck_progress"
                        android:importantForAccessibility="no" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <FrameLayout
                    android:id="@+id/deck_favorite"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/cd_widget_favorite"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/deck_favorite_side"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="2dp"
                        android:paddingTop="4dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_deck_key"
                        android:cropToPadding="true"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:id="@+id/deck_favorite_cap"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginHorizontal="2dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_deck_key"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:id="@+id/deck_favorite_icon"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:scaleType="center"
                        android:src="@drawable/ic_favorite_border"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/deck_prev"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/previous"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/deck_prev_side"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="2dp"
                        android:paddingTop="4dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_deck_key"
                        android:cropToPadding="true"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:id="@+id/deck_prev_cap"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginHorizontal="2dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_deck_key"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:id="@+id/deck_prev_icon"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:scaleType="center"
                        android:src="@drawable/ic_skip_prev"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/deck_play"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1.2"
                    android:contentDescription="@string/play_pause"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/deck_play_side"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="2dp"
                        android:paddingTop="4dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_deck_key"
                        android:cropToPadding="true"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:id="@+id/deck_play_cap"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginHorizontal="2dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_deck_key"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:id="@+id/deck_play_icon"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:scaleType="center"
                        android:src="@drawable/ic_play"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/deck_next"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/next"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/deck_next_side"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="2dp"
                        android:paddingTop="4dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_deck_key"
                        android:cropToPadding="true"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:id="@+id/deck_next_cap"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginHorizontal="2dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_deck_key"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:id="@+id/deck_next_icon"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:scaleType="center"
                        android:src="@drawable/ic_skip_next"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/deck_vibe"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/cd_vibe_mode"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/deck_vibe_side"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="2dp"
                        android:paddingTop="4dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_deck_key"
                        android:cropToPadding="true"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:id="@+id/deck_vibe_cap"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginHorizontal="2dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_deck_key"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:id="@+id/deck_vibe_icon"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:scaleType="center"
                        android:src="@drawable/ic_vibe"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/deck_standby"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/deck_standby"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/deck_standby_side"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="2dp"
                        android:paddingTop="4dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_deck_key"
                        android:cropToPadding="true"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:id="@+id/deck_standby_cap"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginHorizontal="2dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_deck_key"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:id="@+id/deck_standby_icon"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:scaleType="center"
                        android:src="@drawable/ic_standby"
                        android:importantForAccessibility="no" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
