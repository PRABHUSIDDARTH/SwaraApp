<?xml version="1.0" encoding="utf-8"?>
<!-- Swara Deck widget. Coloured from DesignTokens by DeckWidgetRenderer; the reel is a bitmap of
     DeckReelView, with two rotating overlays while playing. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/deck_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="UseAppTint,ContentDescription">

    <!-- The Deck body is only as tall as its content; any spare height stays see-through. The
         background layers take the panel's height from the content below them. -->
    <RelativeLayout
        tools:ignore="UselessParent"
        android:id="@+id/deck_widget_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical">

        <ImageView
            android:id="@+id/deck_widget_body"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_alignTop="@+id/deck_widget_content"
            android:layout_alignBottom="@+id/deck_widget_content"
            android:scaleType="fitXY"
            android:src="@drawable/widget_deck_body"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/deck_widget_outline"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_alignTop="@+id/deck_widget_content"
            android:layout_alignBottom="@+id/deck_widget_content"
            android:scaleType="fitXY"
            android:src="@drawable/widget_deck_outline"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/deck_screw_tl"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_alignTop="@+id/deck_widget_content"
            android:layout_margin="6dp"
            android:src="@drawable/widget_deck_screw"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/deck_screw_slot_tl"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_alignTop="@+id/deck_widget_content"
            android:layout_margin="6dp"
            android:src="@drawable/widget_deck_screw_slot"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/deck_screw_tr"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_alignTop="@+id/deck_widget_content"
            android:layout_alignParentEnd="true"
            android:layout_margin="6dp"
            android:src="@drawable/widget_deck_screw"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/deck_screw_slot_tr"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_alignTop="@+id/deck_widget_content"
            android:layout_alignParentEnd="true"
            android:layout_margin="6dp"
            android:src="@drawable/widget_deck_screw_slot"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/deck_screw_bl"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_alignBottom="@+id/deck_widget_content"
            android:layout_margin="6dp"
            android:src="@drawable/widget_deck_screw"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/deck_screw_slot_bl"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_alignBottom="@+id/deck_widget_content"
            android:layout_margin="6dp"
            android:src="@drawable/widget_deck_screw_slot"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/deck_screw_br"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_alignBottom="@+id/deck_widget_content"
            android:layout_alignParentEnd="true"
            android:layout_margin="6dp"
            android:src="@drawable/widget_deck_screw"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/deck_screw_slot_br"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_alignBottom="@+id/deck_widget_content"
            android:layout_alignParentEnd="true"
            android:layout_margin="6dp"
            android:src="@drawable/widget_deck_screw_slot"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/deck_widget_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="10dp">

            <FrameLayout
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_gravity="center_horizontal">

                <ImageView
                    android:id="@+id/deck_reel"
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:contentDescription="@string/cd_deck_reel" />

                <ProgressBar
                    android:id="@+id/deck_spin_windows"
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:indeterminate="true"
                    android:indeterminateDrawable="@drawable/widget_deck_spin_windows"
                    android:indeterminateDuration="10000"
                    android:interpolator="@android:anim/linear_interpolator"
                    android:indeterminateOnly="true"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/deck_spin_marker"
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:indeterminate="true"
                    android:indeterminateDrawable="@drawable/widget_deck_spin_marker"
                    android:indeterminateDuration="10000"
                    android:interpolator="@android:anim/linear_interpolator"
                    android:indeterminateOnly="true"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />

            </FrameLayout>

            <TextView
                android:id="@+id/deck_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/deck_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="12sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <ImageView
                    android:id="@+id/deck_window"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_deck_key"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="30dp"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <Chronometer
                        android:id="@+id/deck_elapsed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/deck_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:textSize="12sp" />
                </LinearLayout>
            </FrameLayout>

            <ProgressBar
                android:id="@+id/deck_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="6dp"
                android:max="1000"
                android:progressDrawable="@drawable/widget_deck_progress"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                    <FrameLayout
                        android:id="@+id/deck_prev"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/previous"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/deck_prev_side"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="2dp"
                            android:paddingTop="4dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/widget_deck_key"
                            android:cropToPadding="true"
                            android:importantForAccessibility="no" />

                        <ImageView
                            android:id="@+id/deck_prev_cap"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginHorizontal="2dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/widget_deck_key"
                            android:importantForAccessibility="no" />

                        <ImageView
                            android:id="@+id/deck_prev_icon"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:scaleType="center"
                            android:src="@drawable/ic_skip_prev"
                            android:importantForAccessibility="no" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/deck_play"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1.2"
                        android:contentDescription="@string/play_pause"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/deck_play_side"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="2dp"
                            android:paddingTop="4dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/widget_deck_key"
                            android:cropToPadding="true"
                            android:importantForAccessibility="no" />

                        <ImageView
                            android:id="@+id/deck_play_cap"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginHorizontal="2dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/widget_deck_key"
                            android:importantForAccessibility="no" />

                        <ImageView
                            android:id="@+id/deck_play_icon"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:scaleType="center"
                            android:src="@drawable/ic_play"
                            android:importantForAccessibility="no" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/deck_next"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/next"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/deck_next_side"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="2dp"
                            android:paddingTop="4dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/widget_deck_key"
                            android:cropToPadding="true"
                            android:importantForAccessibility="no" />

                        <ImageView
                            android:id="@+id/deck_next_cap"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginHorizontal="2dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/widget_deck_key"
                            android:importantForAccessibility="no" />

                        <ImageView
                            android:id="@+id/deck_next_icon"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:scaleType="center"
                            android:src="@drawable/ic_skip_next"
                            android:importantForAccessibility="no" />
                    </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                    <FrameLayout
                        android:id="@+id/deck_favorite"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/cd_widget_favorite"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/deck_favorite_side"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="2dp"
                            android:paddingTop="4dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/widget_deck_key"
                            android:cropToPadding="true"
                            android:importantForAccessibility="no" />

                        <ImageView
                            android:id="@+id/deck_favorite_cap"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginHorizontal="2dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/widget_deck_key"
                            android:importantForAccessibility="no" />

                        <ImageView
                            android:id="@+id/deck_favorite_icon"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:scaleType="center"
                            android:src="@drawable/ic_favorite_border"
                            android:importantForAccessibility="no" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/deck_vibe"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/cd_vibe_mode"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/deck_vibe_side"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="2dp"
                            android:paddingTop="4dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/widget_deck_key"
                            android:cropToPadding="true"
                            android:importantForAccessibility="no" />

                        <ImageView
                            android:id="@+id/deck_vibe_cap"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginHorizontal="2dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/widget_deck_key"
                            android:importantForAccessibility="no" />

                        <ImageView
                            android:id="@+id/deck_vibe_icon"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:scaleType="center"
                            android:src="@drawable/ic_vibe"
                            android:importantForAccessibility="no" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/deck_standby"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/deck_standby"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/deck_standby_side"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="2dp"
                            android:paddingTop="4dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/widget_deck_key"
                            android:cropToPadding="true"
                            android:importantForAccessibility="no" />

                        <ImageView
                            android:id="@+id/deck_standby_cap"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginHorizontal="2dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/widget_deck_key"
                            android:importantForAccessibility="no" />

                        <ImageView
                            android:id="@+id/deck_standby_icon"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:scaleType="center"
                            android:src="@drawable/ic_standby"
                            android:importantForAccessibility="no" />
                    </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
