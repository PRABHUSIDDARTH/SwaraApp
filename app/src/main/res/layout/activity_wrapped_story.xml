<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/storyRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.psthetech.swara.wrapped.ui.StoryView
        android:id="@+id/storyView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/storyLoading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="#FFFFFF" />

    <ImageButton
        android:id="@+id/btnStoryClose"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/ripple_circle"
        android:contentDescription="@string/wrapped_close"
        android:src="@drawable/ic_close"
        app:tint="#FFFFFF"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <LinearLayout
        android:id="@+id/storyActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStoryVideo"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:text="@string/wrapped_save_video"
            android:textColor="#160A26"
            android:visibility="gone"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="24dp"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <ImageButton
            android:id="@+id/btnStoryShare"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_play_button"
            android:contentDescription="@string/wrapped_share_slide"
            android:src="@drawable/ic_share"
            app:tint="#160A26"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
    </LinearLayout>
</FrameLayout>
