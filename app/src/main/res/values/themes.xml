<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===== BASE APPLICATION THEME ===== -->
    <style name="Theme.Swara" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Color system -->
        <item name="colorPrimary">@color/swara_purple</item>
        <item name="colorOnPrimary">@color/swara_cream</item>
        <item name="colorPrimaryContainer">@color/swara_surface_2</item>
        <item name="colorOnPrimaryContainer">@color/swara_cream</item>

        <item name="colorSecondary">@color/swara_gold</item>
        <item name="colorOnSecondary">@color/swara_night</item>
        <item name="colorSecondaryContainer">@color/swara_gold_alpha_20</item>
        <item name="colorOnSecondaryContainer">@color/swara_cream</item>

        <item name="colorTertiary">@color/swara_lavender</item>
        <item name="colorOnTertiary">@color/swara_night</item>

        <item name="android:colorBackground">@color/swara_night</item>
        <item name="colorSurface">@color/swara_surface_1</item>
        <item name="colorOnSurface">@color/swara_cream</item>
        <item name="colorSurfaceVariant">@color/swara_surface_2</item>
        <item name="colorOnSurfaceVariant">@color/swara_lavender</item>

        <item name="colorOutline">@color/swara_glass_stroke</item>

        <!-- Typography -->
        <item name="android:textColorPrimary">@color/swara_text_primary</item>
        <item name="android:textColorSecondary">@color/swara_text_secondary</item>
        <item name="android:textColorHint">@color/swara_text_hint</item>

        <!-- Status / navigation bars -->
        <item name="android:statusBarColor">@color/swara_night</item>
        <item name="android:navigationBarColor">@color/swara_night</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Window -->
        <item name="android:windowBackground">@color/swara_night</item>
    </style>

    <!-- ===== SPLASH SCREEN ===== -->
    <style name="Theme.SwaraLauncher" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/swara_night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Swara</item>
    </style>

    <!-- ===== BOTTOM SHEET ===== -->
    <style name="Theme.Swara.BottomSheet" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="android:colorBackground">@color/swara_surface_2</item>
        <item name="colorPrimary">@color/swara_gold</item>
        <item name="colorOnSurface">@color/swara_cream</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/swara_surface_2</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="bottomSheetStyle">@style/Widget.Swara.BottomSheet</item>
    </style>

    <style name="Widget.Swara.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@color/swara_surface_2</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Swara.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.Swara.BottomSheet" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/radius_lg</item>
        <item name="cornerSizeTopRight">@dimen/radius_lg</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- ===== CARD STYLES ===== -->
    <style name="Widget.Swara.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/swara_surface_2</item>
        <item name="cardElevation">@dimen/elevation_1</item>
        <item name="cardCornerRadius">@dimen/radius_md</item>
        <item name="strokeColor">@color/swara_glass_stroke</item>
        <item name="strokeWidth">@dimen/border_regular</item>
    </style>

    <style name="Widget.Swara.Card.Flat" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/swara_surface_1</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">@dimen/radius_md</item>
        <item name="strokeColor">@color/swara_glass_stroke</item>
        <item name="strokeWidth">@dimen/border_thin</item>
    </style>

    <!-- ===== BUTTON STYLES ===== -->
    <style name="Widget.Swara.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/swara_gold</item>
        <item name="android:textColor">@color/swara_night</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">@dimen/radius_full</item>
        <item name="rippleColor">@color/swara_white_alpha_12</item>
    </style>

    <style name="Widget.Swara.Button.Ghost" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/swara_glass_stroke</item>
        <item name="android:textColor">@color/swara_cream</item>
        <item name="cornerRadius">@dimen/radius_full</item>
        <item name="rippleColor">@color/swara_gold_alpha_20</item>
    </style>

    <style name="Widget.Swara.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/swara_gold</item>
        <item name="rippleColor">@color/swara_gold_alpha_20</item>
    </style>

    <!-- ===== TEXT FIELD STYLE ===== -->
    <style name="Widget.Swara.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/swara_surface_2</item>
        <item name="boxStrokeColor">@color/swara_glass_stroke</item>
        <item name="hintTextColor">@color/swara_text_hint</item>
        <item name="android:textColorHint">@color/swara_text_hint</item>
        <item name="android:textColor">@color/swara_cream</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
    </style>

    <!-- ===== TYPOGRAPHY ===== -->
    <style name="TextAppearance.Swara.Display" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:textColor">@color/swara_text_primary</item>
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Swara.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/swara_text_primary</item>
        <item name="android:textSize">@dimen/text_headline_lg</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Swara.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/swara_text_primary</item>
        <item name="android:textSize">@dimen/text_headline_md</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Swara.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/swara_text_primary</item>
        <item name="android:textSize">@dimen/text_title_lg</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Swara.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/swara_text_primary</item>
        <item name="android:textSize">@dimen/text_title_md</item>
    </style>

    <style name="TextAppearance.Swara.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/swara_text_secondary</item>
        <item name="android:textSize">@dimen/text_body_md</item>
    </style>

    <style name="TextAppearance.Swara.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/swara_text_secondary</item>
        <item name="android:textSize">@dimen/text_body_sm</item>
    </style>

    <style name="TextAppearance.Swara.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/swara_text_dim</item>
        <item name="android:textSize">@dimen/text_label_md</item>
    </style>

    <!-- ===== TAB LAYOUT ===== -->
    <style name="Widget.Swara.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabSelectedTextColor">@color/swara_gold</item>
        <item name="tabTextColor">@color/swara_lavender</item>
        <item name="tabIndicatorColor">@color/swara_gold</item>
        <item name="tabBackground">@android:color/transparent</item>
        <item name="android:background">@color/swara_surface_1</item>
    </style>

    <!-- ===== DIALOG ===== -->
    <style name="Theme.Swara.Dialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:colorBackground">@color/swara_surface_2</item>
        <item name="colorPrimary">@color/swara_gold</item>
        <item name="colorOnSurface">@color/swara_cream</item>
        <item name="android:textColorPrimary">@color/swara_cream</item>
        <item name="android:textColorSecondary">@color/swara_lavender</item>
    </style>

    <!-- ===== POPUP MENU ===== -->
    <style name="Widget.Swara.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@color/swara_surface_2</item>
        <item name="android:textColor">@color/swara_cream</item>
    </style>

    <!-- ===== BOTTOM NAV INDICATOR ===== -->
    <style name="Widget.Swara.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/swara_gold_alpha_20</item>
    </style>

</resources>